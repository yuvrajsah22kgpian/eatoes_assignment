{
	"info": {
		"_postman_id": "eatoes-backend-collection",
		"name": "Eatoes Backend API",
		"description": "API collection for Eatoes Backend",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Users",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"testuser\",\n    \"email\": \"test@example.com\",\n    \"password\": \"password123\",\n    \"address\": \"123 Main St\",\n    \"phone\": \"1234567890\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/users/register",
							"host": ["{{base_url}}"],
							"path": ["api", "users", "register"]
						},
						"description": "Register a new user"
					}
				},
				{
					"name": "Get User Profile",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/api/users/:id",
							"host": ["{{base_url}}"],
							"path": ["api", "users", ":id"]
						},
						"description": "Get user profile by ID"
					}
				},
				{
					"name": "Update User Profile",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"username\": \"updatedusername\",\n    \"email\": \"updated@example.com\"\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/users/:id",
							"host": ["{{base_url}}"],
							"path": ["api", "users", ":id"]
						},
						"description": "Update user profile by ID"
					}
				}
			]
		},
		{
			"name": "Products",
			"item": [
				{
					"name": "Get All Products",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/api/products",
							"host": ["{{base_url}}"],
							"path": ["api", "products"]
						},
						"description": "Get all products"
					}
				},
				{
					"name": "Get Single Product",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/api/products/:id",
							"host": ["{{base_url}}"],
							"path": ["api", "products", ":id"]
						},
						"description": "Get a single product by ID"
					}
				},
				{
					"name": "Create Product",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Test Product\",\n    \"price\": 99.99,\n    \"category\": \"Electronics\",\n    \"description\": \"Test product description\",\n    \"stock\": 100,\n    \"images\": [\"image1.jpg\", \"image2.jpg\"],\n    \"attributes\": {\n        \"color\": \"red\",\n        \"size\": \"large\"\n    },\n    \"tags\": [\"electronics\", \"test\"]\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/products",
							"host": ["{{base_url}}"],
							"path": ["api", "products"]
						},
						"description": "Create a new product"
					}
				},
				{
					"name": "Update Product",
					"request": {
						"method": "PUT",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"name\": \"Updated Product\",\n    \"price\": 149.99,\n    \"stock\": 50\n}"
						},
						"url": {
							"raw": "{{base_url}}/api/products/:id",
							"host": ["{{base_url}}"],
							"path": ["api", "products", ":id"]
						},
						"description": "Update a product"
					}
				},
				{
					"name": "Delete Product",
					"request": {
						"method": "DELETE",
						"url": {
							"raw": "{{base_url}}/api/products/:id",
							"host": ["{{base_url}}"],
							"path": ["api", "products", ":id"]
						},
						"description": "Delete a product"
					}
				}
			]
		},
		{
			"name": "Orders",
			"item": [
				{
					"name": "Post Order",
					"request": {
						"method": "POST",
						"url": {
							"raw": "{{base_url}}/api/orders/post_order",
							"host": ["{{base_url}}"],
							"path": ["api", "orders", "post_order"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"user_id\": 1,\n    \"order_details\": [\n        {\n            \"product_id\": 1,\n            \"quantity\": 2\n        }\n    ]\n}"
						},
						"description": "Post a new order"
					}
				},
				{
					"name": "Get Order History",
					"request": {
						"method": "GET",
						"url": {
							"raw": "{{base_url}}/api/orders/get_order_history/:user_id",
							"host": ["{{base_url}}"],
							"path": ["api", "orders", "get_order_history", ":user_id"]
						},
						"description": "Get order history by user ID"
					}
				},
				{
					"name": "Update Order",
					"request": {
						"method": "PUT",
						"url": {
							"raw": "{{base_url}}/api/orders/update_order/:order_id",
							"host": ["{{base_url}}"],
							"path": ["api", "orders", "update_order", ":order_id"]
						},
						"body": {
							"mode": "raw",
							"raw": "{\n    \"status\": \"completed\"\n}"
						},
						"description": "Update order status"
					}
				},
				{
					"name": "Delete Order",
					"request": {
						"method": "DELETE",
						"url": {
							"raw": "{{base_url}}/api/orders/delete_order/:order_id",
							"host": ["{{base_url}}"],
							"path": ["api", "orders", "delete_order", ":order_id"]
						},
						"description": "Delete an order"
					}
				}
				
			]
		}
	],
	"variable": [
		{
			"key": "base_url",
			"value": "http://localhost:3000",
			"type": "string"
		}
	]
} 